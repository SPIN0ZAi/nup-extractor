<Window x:Class="NupExtractorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NUP Extractor · Switch Clean-Room Container Utility"
        Height="820" Width="1240" MinHeight="48" MinWidth="48"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="Transparent">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome x:Name="AppWindowChrome"
                            CaptionHeight="0"
                            GlassFrameThickness="-1"
                            ResizeBorderThickness="0"
                            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Grid Background="Transparent">
        <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="Transparent" />
    </Grid>
</Window>
